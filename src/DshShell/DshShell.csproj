<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- [v0.4.1] windows10.0.19041：引入 SDK 的 WinRT 投影（Windows.UI.Notifications），
         系统通知（Toast）不再依赖托盘图标 NotifyIcon。 -->
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>DshWeb</AssemblyName>
    <RootNamespace>DshWeb</RootNamespace>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>false</SelfContained>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <!-- Per-Monitor V2 DPI awareness（WinForms 运行时配置，150% 缩放下 WebView2 按
         真实 DPI 渲染，与浏览器一致，否则位图拉伸导致模糊 issue #2）。
         注意：WinForms 10 会从自定义 manifest 删除 DPI 段（WFO0003），
         必须用 ApplicationHighDpiMode / Application.SetHighDpiMode 配置。 -->
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="favicon.png" />
    <EmbeddedResource Include="favicon-white.png" />
    <EmbeddedResource Include="favicon-blue.png" />
    <Content Include="app.ico" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4129.50" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="DshShell.Tests" />
  </ItemGroup>

  <!-- 源码构建/发布后自动把部署脚本复制到输出目录：让 dotnet build/publish 出来的
       DshWeb.exe 可直接使用（启动时需要同目录的 start-dsh.vbs 等），不必再手动复制。 -->
  <Target Name="CopyDeployScripts" AfterTargets="Build">
    <Copy SourceFiles="..\..\scripts\start-dsh.vbs;..\..\scripts\start-dsh.cmd;..\..\scripts\dsh-web.cmd;..\..\scripts\uninstall-autostart.cmd"
          DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" />
  </Target>
  <Target Name="CopyDeployScriptsPublish" AfterTargets="Publish">
    <Copy SourceFiles="..\..\scripts\start-dsh.vbs;..\..\scripts\start-dsh.cmd;..\..\scripts\dsh-web.cmd;..\..\scripts\uninstall-autostart.cmd"
          DestinationFolder="$(PublishDir)" SkipUnchangedFiles="true" />
  </Target>

</Project>
