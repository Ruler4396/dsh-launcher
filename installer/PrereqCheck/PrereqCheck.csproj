<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- WinExe（GUI 子系统）：避免控制台窗口；MSI 向导"下一步"前执行（Type-38 外部 exe，
         与 FolderPicker 同模式，客户端进程内弹窗）。 -->
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <!-- 不用 WPF/WinForms：本程序要在"机器可能根本没有 .NET"的现场跑起来（它检测的第一件事就是
         .NET 在不在），任何托管 UI 栈都是自相矛盾——旧实现正是框架依赖的 WPF 程序，没装 .NET 的
         机器上 apphost 抢先弹"你必须安装 .NET Desktop Runtime"，检查逻辑一行都没执行。
         对话框改用 user32 MessageBoxW（见 PrereqCheck.cs 的 Ask）。 -->
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>PrereqCheck</AssemblyName>
    <!-- Native AOT：产物是原生 exe，不依赖任何共享框架。这是本程序存在的**前提**而非优化——
         它检测的第一件事就是"这台机器有没有 .NET"，框架依赖的产物在缺 .NET 的机器上由 apphost
         抢先弹自己的缺运行时对话框，检查逻辑一行都跑不到（v0.5.1 及以前即如此，用户实拍）。
         注意不要再写 SelfContained=false / PublishSingleFile：PublishAot 隐含自包含，而
         CI 实测 `SelfContained=false` + `-p:PublishAot=true` 会被 ILLink 判为
         error NETSDK1102（"size optimization 需要 self-contained"）直接红。 -->
    <PublishAot>true</PublishAot>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
  </PropertyGroup>
</Project>
