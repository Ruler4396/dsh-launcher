<?xml version="1.0" encoding="UTF-8"?>
<!--
  dsh-launcher per-machine MSI installer (WiX Toolset v5, schema v4).

  Design (security-first):
  - Scope="perMachine" + elevated: install/repair/remove run with admin (UAC
    prompt) and register in HKLM. Elevation is REQUIRED for a correct uninstall
    on disks whose root Config.Msi ACL (created by the MSI service as SYSTEM
    only) blocks the non-elevated client from setting security on rollback
    files (.rbf), which otherwise surfaces as error 1926 / error 5 during
    uninstall (see docs/DETAILS.md FAQ). Elevated transactions match the
    BUILTIN\Administrators ACE on Config.Msi, so uninstall is clean.
  - Default folder: %ProgramFiles%\dsh-launcher; the wizard still allows a
    custom folder (WIXUI_INSTALLDIR), e.g. an existing E:\ directory.
  - Autostart is a plain HKCU\...\Run value (removed on uninstall).
  - Desktop / Start Menu shortcuts and uninstall shortcut are created for the
    installing user (public folders) and removed on uninstall.
  - UpgradeCode is fixed so future versions upgrade in place via MajorUpgrade.
    NOTE: per-user installs of 0.1.5 and earlier are in HKCU; a per-machine
    upgrade cannot see them (MSI searches only the same context), so upgrading
    from a per-user build requires uninstalling the old version first.

  UI: a simple wizard (Welcome → License → Options → Ready → Install → Finish)
  with exactly three checkboxes (autostart / desktop shortcut / start menu
  shortcut), no feature tree, with a modern install-folder page.

  Build (see scripts/build-release.ps1):
    wix build installer\product.wxs -arch x64 -d ProductVersion=<x.y.z> -d SourceDir=<assemble dir> -o dist\dsh-launcher-<version>.msi
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">

  <Package Name="dsh-launcher"
           Manufacturer="dsh-launcher contributors"
           Version="$(var.ProductVersion)"
           UpgradeCode="3B29D055-E142-43BD-ADA8-C5377D11BD7E"
           Scope="perMachine">
    <MajorUpgrade DowngradeErrorMessage="A newer version of dsh-launcher is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="dsh-launcher">
        <Directory Id="RuntimesDir" Name="runtimes">
          <Directory Id="WinX64Dir" Name="win-x64">
            <Directory Id="NativeDir" Name="native" />
          </Directory>
        </Directory>
      </Directory>
    </StandardDirectory>
    <StandardDirectory Id="DesktopFolder" />
    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="ProgramMenuDir" Name="dsh-launcher" />
    </StandardDirectory>

    <!-- Main is always installed; the two shortcut features map to the wizard checkboxes
         (Level elements turn the feature off when the matching checkbox is unchecked).
         自启标志由 SetAutoStartFlag CA 直接写注册表（不再使用 Feature Level 或
         Component 条件：MSI 在修改安装场景下对 Absent feature / 已安装组件的条件
         均不重新评估，0.2.4/0.2.5 实测）。 -->
    <Feature Id="Main" Title="dsh-launcher" Description="dsh-launcher application files" Level="1">
      <ComponentGroupRef Id="AppFiles" />
      <ComponentRef Id="UninstallShortcut" />
      <ComponentRef Id="CurrentProductCodeReg" />
      <ComponentRef Id="DisplayIconReg" />
    </Feature>
    <Feature Id="DesktopShortcut" Title="桌面快捷方式" Description="在桌面创建 dsh-launcher 快捷方式" Level="1">
      <Level Value="0" Condition="NOT DESKTOP_SHORTCUT_OPTION" />
      <ComponentRef Id="DesktopShortcut" />
    </Feature>
    <Feature Id="MenuShortcut" Title="开始菜单快捷方式" Description="在开始菜单创建 dsh-launcher 快捷方式" Level="1">
      <Level Value="0" Condition="NOT MENU_SHORTCUT_OPTION" />
      <ComponentRef Id="ProgramMenuShortcut" />
    </Feature>

    <!-- checkbox 默认值：开机自启默认【不勾选】（dsh 服务内存占用相对较大，非必要不推荐开启）；
         快捷方式默认勾选；WIXUI_INSTALLDIR 指向目录选择页。
         注意：默认不勾的 checkbox 属性必须【无默认值】——MSI CheckBox 控件对存在非空值的
         属性（哪怕 "0"）会渲染为勾选状态，UI 与实际 feature 状态不一致（0.2.4 实测：
         默认勾上但组件未装，用户以为启用了自启）。属性不存在 → 不勾；勾选 → "1"；
         取消勾选 → 空串。Level 条件 AUTO_START_OPTION <> 1 对三者均正确。 -->
<Property Id="AUTO_START_OPTION" Secure="yes" />
    <Property Id="DESKTOP_SHORTCUT_OPTION" Value="1" Secure="yes" />
    <Property Id="MENU_SHORTCUT_OPTION" Value="1" Secure="yes" />
    <Property Id="WIXUI_INSTALLDIR" Value="INSTALLFOLDER" Secure="yes" />

    <!-- 应用图标（小鲸鱼）：显示在快捷方式与"设置 → 应用"卸载条目上。
         exe 本身也编译了该图标（ApplicationIcon），这里显式引用保证一致。 -->
    <Icon Id="AppIcon" SourceFile="$(sys.SOURCEFILEDIR)..\src\DshShell\app.ico" />
    <Property Id="ARPPRODUCTICON" Value="AppIcon" />

    <!-- 安装期禁用回滚的额外保险（本包仅 7 个小文件，代价可接受）。
         卸载期的 1926/错误5 由 per-machine 提权解决：提权事务匹配 Config.Msi 上
         BUILTIN\Administrators 的 ACL，回滚文件（.rbf）的安全设置不会失败。 -->
    <Property Id="DISABLEROLLBACK" Value="1" Secure="yes" />

    <UI>
      <ui:WixUI Id="WixUI_SimpleCheckbox" />
    </UI>

    <!-- 现代化文件夹选择器（两个自定义动作配合，均已实测验证）：
         ① LaunchModernFolderPicker：Type-38 外部 exe（FolderPicker.exe），**客户端进程**
            内弹 Windows 11/10 新版文件夹对话框（IFileDialog），把所选路径写到
            C:\ProgramData\dsh-launcher\picked.txt（用户与服务端都可读写）
         ② ReadPickedFolder：DTF Type-1 托管 CA（net20，SfxCA 打包，无需 C++ 工具链）——
            **本环境实测 DLL CA 恒被 marshal 到 msiexec 服务端执行**（Invoking remote
            custom action / Connected to service），但 MsiSetProperty 的回写**会同步回
            客户端 UI**（日志实证：MSI (c) PROPERTY CHANGE: Modifying INSTALLFOLDER）；
            该 CA 读中转文件 → 写 _BrowseProperty 所指的目录属性（INSTALLFOLDER）→
            PathEdit 即时刷新。构建目标 net20 匹配 SfxCA 绑定的 CLR v2.0.50727
            （net48 会 BadImageFormatException）。取消时 picker 不留文件，路径不变。 -->
    <Binary Id="FolderPickerExe"
            SourceFile="$(sys.SOURCEFILEDIR)FolderPicker\out\FolderPicker.exe" />
    <Binary Id="FolderPickerCa"
            SourceFile="$(sys.SOURCEFILEDIR)FolderPickerCa\bin\x64\Release\net20\FolderPickerCa.CA.dll" />
    <Binary Id="PrereqCheckExe"
            SourceFile="$(sys.SOURCEFILEDIR)PrereqCheck\out\PrereqCheck.exe" />
    <CustomAction Id="LaunchModernFolderPicker" BinaryRef="FolderPickerExe"
                  ExeCommand="&quot;[INSTALLFOLDER]&quot;"
                  Execute="immediate" Return="check" />
    <CustomAction Id="ReadPickedFolder" BinaryRef="FolderPickerCa"
                  DllEntry="LaunchFolderPicker"
                  Execute="immediate" Return="check" />
<!-- 卸载清理自启项：per-machine 卸载（提权）无法用注册表组件可靠删 HKCU（对称问题），
         且 Level 条件在卸载时重评会使禁用 feature 的组件（含 HKLM 标志）不清理，
         改由本 immediate CA（发起用户上下文，卸载提权可写 HKLM）统一删除：
         1) HKCU Run 的 dsh-launcher 值（仅内容含 start-dsh.vbs 的，防误删）；
         2) HKLM\Software\dsh-launcher\AutoStartWanted 意图标志。
         调度条件含 NOT UPGRADINGPRODUCTCODE（升级不触发）。Return="ignore"：清理
         失败不阻断卸载。 -->
<CustomAction Id="RemoveAutoRun" BinaryRef="FolderPickerCa"
                  DllEntry="RemoveAutoRun"
                  Execute="immediate" Return="ignore" />
    <!-- 卸载清理用户数据（v0.3.0）：只清理 DSH_HOME\dsh-launcher\ 与旧版 .dsh-web*.log，
         绝不触碰 dsh 生态（profiles/settings.yaml/插件等）；顺带杀死 pid 文件记录的
         壳托管服务进程（只动我们记录的 PID）。Return="ignore"：清理失败不阻断卸载。 -->
    <CustomAction Id="CleanUserData" BinaryRef="FolderPickerCa"
                  DllEntry="CleanUserData"
                  Execute="immediate" Return="ignore" />
    <!-- 安装/修改时自启两级落地：AUTO_START_OPTION=1（checkbox 勾选）时写
         1) HKLM\Software\dsh-launcher\AutoStartWanted=1（机器级意图标志）；
         2) HKCU Run dsh-launcher（当前用户登录自启，装完直接重启即生效，
            无需先启动壳——0.2.5 实测仅靠壳首启自愈则该场景永远不落地）。
         不使用组件条件（Feature Level / Component Condition 在修改安装时
         不重新评估，实测失效）。 -->
    <CustomAction Id="SetAutoStartFlag" BinaryRef="FolderPickerCa"
                  DllEntry="SetAutoStartFlag"
                  Execute="immediate" Return="ignore" />
    <!-- 安装前置检查（用户要求）：.NET Desktop Runtime 10 与 Node.js 缺失时弹窗引导下载。
         Type-38 外部 exe（客户端进程内 MessageBox）。调度见下方 Fragment 的 InstallUISequence
         （Sequence=1 最早执行，客户端 UI 上下文、弹窗可见）；Return="check" 使缺失/取消
         （退出码 2/3）中止安装。 -->
    <CustomAction Id="CheckPrereq" BinaryRef="PrereqCheckExe"
                  ExeCommand="" Execute="immediate" Return="check" />
  </Package>

  <Fragment>
    <!-- 前置检查调度：InstallUISequence 最早（Sequence=1，向导启动即弹）；
         InstallExecuteSequence 也放最前（无 UI 的静默/命令行安装同样检查）。
         两个序列都只对"全新安装"（NOT Installed）执行——升级/修复/卸载不拦截。 -->
    <InstallUISequence>
      <Custom Action="CheckPrereq" Sequence="1" Condition="NOT Installed" />
    </InstallUISequence>
    <InstallExecuteSequence>
      <Custom Action="CheckPrereq" Sequence="1" Condition="NOT Installed" />
      <!-- 安装/修改时自启两级落地（AUTO_START_OPTION=1 时触发：写 HKLM 标志 + HKCU Run）。
           调度在 InstallValidate 之后：属性已从命令行/UI 确定，INSTALLFOLDER 已解析。 -->
      <Custom Action="SetAutoStartFlag" After="InstallValidate" Condition="AUTO_START_OPTION = &quot;1&quot;" />
      <!-- 卸载时清理当前用户 HKCU Run 自启值与 HKLM 意图标志（REMOVE=ALL：完整卸载）。
           NOT UPGRADINGPRODUCTCODE：升级不触发（升级后壳首启按新包标志重新落地，
           用户已启用的自启跨版本保留）。 -->
      <Custom Action="RemoveAutoRun" After="InstallInitialize" Condition="REMOVE~=&quot;ALL&quot; AND NOT UPGRADINGPRODUCTCODE" />
      <!-- 卸载清理用户数据（v0.3.0，同一调度窗口：完整卸载且非升级链路） -->
      <Custom Action="CleanUserData" After="RemoveAutoRun" Condition="REMOVE~=&quot;ALL&quot; AND NOT UPGRADINGPRODUCTCODE" />
    </InstallExecuteSequence>

    <!-- license page shown by the WixUI wizard (resolved relative to this file) -->
    <WixVariable Id="WixUILicenseRtf" Value="$(sys.SOURCEFILEDIR)License.rtf" />

    <ComponentGroup Id="AppFiles">
      <Component Directory="INSTALLFOLDER" Guid="*">
        <File Source="$(var.SourceDir)\DshWeb.exe" />
      </Component>
      <Component Directory="INSTALLFOLDER" Guid="*">
        <File Source="$(var.SourceDir)\WebView2Loader.dll" />
      </Component>
      <Component Directory="NativeDir" Guid="*">
        <File Source="$(var.SourceDir)\runtimes\win-x64\native\WebView2Loader.dll" />
      </Component>
      <Component Directory="INSTALLFOLDER" Guid="*">
        <File Source="$(var.SourceDir)\start-dsh.vbs" />
      </Component>
      <Component Directory="INSTALLFOLDER" Guid="*">
        <File Source="$(var.SourceDir)\start-dsh.cmd" />
      </Component>
      <Component Directory="INSTALLFOLDER" Guid="*">
        <File Source="$(var.SourceDir)\dsh-web.cmd" />
      </Component>
      <Component Directory="INSTALLFOLDER" Guid="*">
        <File Source="$(var.SourceDir)\uninstall-autostart.cmd" />
      </Component>
    </ComponentGroup>

    <!-- 当前产品代码：壳程序据此识别"正在运行的这个版本"，升级清理旧版时永不误卸自己。
         安装（per-machine，提权）写 HKLM，卸载时随组件删除。 -->
    <Component Id="CurrentProductCodeReg" Directory="INSTALLFOLDER" Guid="*">
      <RegistryValue Root="HKLM"
                     Key="Software\dsh-launcher"
                     Name="CurrentProductCode"
                     Value="[ProductCode]"
                     Type="string"
                     KeyPath="yes" />
    </Component>

    <!-- 卸载条目图标（设置 → 应用 显示）：MSI 的 ARPPRODUCTICON 只影响旧控制面板，
         新"设置 → 应用"读注册表 DisplayIcon 值，这里显式指向 exe（其自带小鲸鱼图标）。 -->
    <Component Id="DisplayIconReg" Directory="INSTALLFOLDER" Guid="*">
      <RegistryValue Root="HKLM"
                     Key="Software\Microsoft\Windows\CurrentVersion\Uninstall\[ProductCode]"
                     Name="DisplayIcon"
                     Value="[INSTALLFOLDER]DshWeb.exe"
                     Type="string"
                     KeyPath="yes" />
    </Component>

    <!-- 自启意图标志由 SetAutoStartFlag CA 直接写 HKLM（不再使用组件机制）。
         原因：MSI 的 Feature Level 条件和 Component 条件在修改安装场景下
         均不重新评估（0.2.4/0.2.5 实测），导致 checkbox 勾选也不生效。
         CA 直接操作注册表，所有场景（全新/修改/升级/修复）一致可靠。 -->

    <Component Id="DesktopShortcut" Directory="DesktopFolder" Guid="*">
      <Shortcut Id="DesktopShortcutLnk"
                Name="dsh-launcher"
                Description="DeepSeek Harness Windows launcher"
                Target="[INSTALLFOLDER]DshWeb.exe"
                WorkingDirectory="INSTALLFOLDER"
                Icon="AppIcon" />
      <RegistryValue Root="HKCU"
                     Key="Software\dsh-launcher\Shortcuts"
                     Name="desktop"
                     Value="1"
                     Type="integer"
                     KeyPath="yes" />
    </Component>

    <Component Id="ProgramMenuShortcut" Directory="ProgramMenuDir" Guid="*">
      <Shortcut Id="ProgramMenuShortcutLnk"
                Name="DeepSeek Harness"
                Description="DeepSeek Harness Windows launcher"
                Target="[INSTALLFOLDER]DshWeb.exe"
                WorkingDirectory="INSTALLFOLDER"
                Icon="AppIcon" />
      <RemoveFolder Id="RemoveProgramMenuDir" Directory="ProgramMenuDir" On="uninstall" />
      <RegistryValue Root="HKCU"
                     Key="Software\dsh-launcher\Shortcuts"
                     Name="startmenu"
                     Value="1"
                     Type="integer"
                     KeyPath="yes" />
    </Component>

    <!-- one-click uninstall from the Start Menu (always installed) -->
    <Component Id="UninstallShortcut" Directory="ProgramMenuDir" Guid="*">
      <Shortcut Id="UninstallShortcutLnk"
                Name="卸载 dsh-launcher"
                Description="Uninstall dsh-launcher"
                Target="[System64Folder]msiexec.exe"
                Arguments="/x [ProductCode]"
                Icon="AppIcon" />
      <RegistryValue Root="HKCU"
                     Key="Software\dsh-launcher\Shortcuts"
                     Name="uninstall"
                     Value="1"
                     Type="integer"
                     KeyPath="yes" />
    </Component>
  </Fragment>

  <!-- 简单向导：Welcome → License → Options(三个勾选框) → ChooseFolder(自定义目录) → Ready → Install → Finish；
       已安装时走 MaintenanceWelcome → MaintenanceType(修复/移除)。
       Id 带 _X64 后缀（<ui:WixUI> 引用时会按构建架构追加后缀）。 -->
  <Fragment>
    <UI Id="WixUI_SimpleCheckbox_X64">
      <TextStyle Id="WixUI_Font_Normal" FaceName="Tahoma" Size="8" />
      <TextStyle Id="WixUI_Font_Bigger" FaceName="Tahoma" Size="12" />
      <TextStyle Id="WixUI_Font_Title" FaceName="Tahoma" Size="9" Bold="yes" />
      <!-- 自定义页使用的现代字体 -->
      <TextStyle Id="DshUIFont" FaceName="Segoe UI" Size="9" />
      <TextStyle Id="DshUIFontBold" FaceName="Segoe UI" Size="9" Bold="yes" />
      <Property Id="DefaultUIFont" Value="WixUI_Font_Normal" />

      <DialogRef Id="WelcomeDlg" />
      <DialogRef Id="LicenseAgreementDlg" />
      <DialogRef Id="OptionsDlg" />
      <DialogRef Id="ChooseFolderDlg" />
      <DialogRef Id="BrowseDlg" />
      <DialogRef Id="InvalidDirDlg" />
      <DialogRef Id="VerifyReadyDlg" />
      <DialogRef Id="ProgressDlg" />
      <DialogRef Id="ExitDialog" />
      <DialogRef Id="MaintenanceWelcomeDlg" />
      <DialogRef Id="MaintenanceTypeDlg" />
      <DialogRef Id="ErrorDlg" />
      <DialogRef Id="FatalError" />
      <DialogRef Id="FilesInUse" />
      <DialogRef Id="MsiRMFilesInUse" />
      <DialogRef Id="PrepareDlg" />
      <DialogRef Id="ResumeDlg" />
      <DialogRef Id="UserExit" />

      <Publish Dialog="LicenseAgreementDlg" Control="Print" Event="DoAction" Value="WixUIPrintEula_X64" />

      <Publish Dialog="ExitDialog" Control="Finish" Event="EndDialog" Value="Return" Order="999" />

      <Publish Dialog="WelcomeDlg" Control="Next" Event="NewDialog" Value="LicenseAgreementDlg" Condition="NOT Installed" />
      <Publish Dialog="WelcomeDlg" Control="Next" Event="NewDialog" Value="MaintenanceTypeDlg" Condition="Installed AND NOT PATCH" />
      <Publish Dialog="WelcomeDlg" Control="Next" Event="NewDialog" Value="VerifyReadyDlg" Condition="Installed AND PATCH" />

      <Publish Dialog="LicenseAgreementDlg" Control="Back" Event="NewDialog" Value="WelcomeDlg" />
      <Publish Dialog="LicenseAgreementDlg" Control="Next" Event="NewDialog" Value="OptionsDlg" Condition="LicenseAccepted = &quot;1&quot;" />

      <Publish Dialog="OptionsDlg" Control="Back" Event="NewDialog" Value="LicenseAgreementDlg" Condition="1" />

      <Publish Dialog="VerifyReadyDlg" Control="Back" Event="NewDialog" Value="ChooseFolderDlg" Order="1" Condition="NOT Installed" />
      <Publish Dialog="VerifyReadyDlg" Control="Back" Event="NewDialog" Value="MaintenanceTypeDlg" Order="2" Condition="Installed AND NOT PATCH" />
      <Publish Dialog="VerifyReadyDlg" Control="Back" Event="NewDialog" Value="WelcomeDlg" Order="3" Condition="Installed AND PATCH" />

      <Publish Dialog="MaintenanceWelcomeDlg" Control="Next" Event="NewDialog" Value="MaintenanceTypeDlg" />
      <Publish Dialog="MaintenanceTypeDlg" Control="RepairButton" Event="NewDialog" Value="VerifyReadyDlg" />
      <Publish Dialog="MaintenanceTypeDlg" Control="RemoveButton" Event="NewDialog" Value="VerifyReadyDlg" />
      <Publish Dialog="MaintenanceTypeDlg" Control="Back" Event="NewDialog" Value="MaintenanceWelcomeDlg" />

      <Property Id="ARPNOMODIFY" Value="1" />
    </UI>
    <UIRef Id="WixUI_Common" />
  </Fragment>

  <!-- 安装选项对话框：三个勾选框（Segoe UI 风格） -->
  <Fragment>
    <UI>
      <Dialog Id="OptionsDlg" Width="370" Height="270" Title="[ProductName] — 安装选项">
        <Control Id="BannerBitmap" Type="Bitmap" X="0" Y="0" Width="370" Height="44" TabSkip="yes" Text="!(loc.InstallDirDlgBannerBitmap)" />
        <Control Id="Title" Type="Text" X="15" Y="6" Width="340" Height="15" Transparent="yes" Text="{\DshUIFontBold}安装选项" />
        <Control Id="Description" Type="Text" X="15" Y="23" Width="340" Height="15" Transparent="yes" Text="{\DshUIFont}选择要启用的功能" />
        <Control Id="BannerLine" Type="Line" X="0" Y="44" Width="370" Height="0" />
        <Control Id="BottomLine" Type="Line" X="0" Y="234" Width="370" Height="0" />
        <Control Id="Back" Type="PushButton" X="180" Y="243" Width="56" Height="17" Text="上一步(&amp;B)" />
        <Control Id="Next" Type="PushButton" X="236" Y="243" Width="56" Height="17" Default="yes" Text="下一步(&amp;N)">
          <Publish Event="NewDialog" Value="ChooseFolderDlg" Condition="1" />
        </Control>
        <Control Id="Cancel" Type="PushButton" X="304" Y="243" Width="56" Height="17" Cancel="yes" Text="取消">
          <Publish Event="EndDialog" Value="Exit" Condition="1" />
        </Control>
        <Control Id="AutoStart" Type="CheckBox" X="25" Y="85" Width="320" Height="34" Property="AUTO_START_OPTION" CheckBoxValue="1" Text="{\DshUIFont}开机自启（登录时静默启动 dsh 服务；&#xA;内存占用相对较大，非必要不推荐开启）" />
        <Control Id="DesktopShortcut" Type="CheckBox" X="25" Y="130" Width="320" Height="17" Property="DESKTOP_SHORTCUT_OPTION" CheckBoxValue="1" Text="{\DshUIFont}创建桌面快捷方式" />
        <Control Id="MenuShortcut" Type="CheckBox" X="25" Y="155" Width="320" Height="17" Property="MENU_SHORTCUT_OPTION" CheckBoxValue="1" Text="{\DshUIFont}创建开始菜单快捷方式" />
        <Control Id="Note" Type="Text" X="25" Y="180" Width="320" Height="40" Text="{\DshUIFont}卸载只删除本应用的 7 个文件，不会删除目录里的其他内容（与 DeepSeek Harness 共用目录也安全）。" />
      </Dialog>
    </UI>
  </Fragment>

  <!-- 选择安装目录：手动输入 + 现代化文件夹选择器（浏览按钮，DTF Type-1 CA）。
       浏览按钮事件链：① 当前安装目录属性名初始化给 _BrowseProperty（间接属性语义）
       ② DoAction LaunchModernFolderPicker（客户端进程弹新版文件夹对话框）
       ③ DoAction ReadPickedFolder（服务端 CA 回写 INSTALLFOLDER=所选路径，
       属性回写已验证生效）④ NewDialog 切到另一份目录对话框——MSI 控件静态绑定，
       属性变化不会让当前对话框控件重绘，重建对话框后 PathEdit 重读属性即回显
       （这就是 BrowseDlg 能回显而 DoAction 路线"看起来不生效"的最后一个原因）。
       两份对话框交替，Back/Next/Cancel 完全一致，VerifyReadyDlg 的 Back 仍回第一份。 -->
  <Fragment>
    <UI>
      <Dialog Id="ChooseFolderDlg" Width="370" Height="270" Title="[ProductName] — 选择安装目录">
        <Control Id="BannerBitmap" Type="Bitmap" X="0" Y="0" Width="370" Height="44" TabSkip="yes" Text="!(loc.InstallDirDlgBannerBitmap)" />
        <Control Id="Title" Type="Text" X="15" Y="6" Width="340" Height="15" Transparent="yes" Text="{\DshUIFontBold}选择安装目录" />
        <Control Id="Description" Type="Text" X="15" Y="23" Width="340" Height="15" Transparent="yes" Text="{\DshUIFont}选择 dsh-launcher 的安装位置" />
        <Control Id="BannerLine" Type="Line" X="0" Y="44" Width="370" Height="0" />
        <Control Id="BottomLine" Type="Line" X="0" Y="234" Width="370" Height="0" />
        <Control Id="FolderLabel" Type="Text" X="20" Y="78" Width="330" Height="15" Text="{\DshUIFont}安装到：" />
        <Control Id="Folder" Type="PathEdit" X="20" Y="95" Width="262" Height="19" Property="WIXUI_INSTALLDIR" Indirect="yes" />
        <Control Id="Browse" Type="PushButton" X="286" Y="94" Width="64" Height="21" Text="浏览(&amp;R)...">
          <Publish Property="_BrowseProperty" Value="[WIXUI_INSTALLDIR]" Order="1" Condition="1" />
          <Publish Event="DoAction" Value="LaunchModernFolderPicker" Order="2" Condition="1" />
          <Publish Event="DoAction" Value="ReadPickedFolder" Order="3" Condition="1" />
          <!-- 重建对话框（NewDialog 销毁当前对话框 → PathEdit 重建时重读 INSTALLFOLDER） -->
          <Publish Event="NewDialog" Value="ChooseFolderDlg2" Order="4" Condition="1" />
        </Control>
        <Control Id="Note" Type="Text" X="20" Y="130" Width="330" Height="45" Text="{\DshUIFont}默认安装到 %ProgramFiles%\dsh-launcher（需管理员确认）。可在此直接输入或粘贴其他路径，如已有的 E:\ 目录；或点「浏览」用系统新版文件夹选择器。卸载只删除本应用的 7 个文件，不会删除目录中的其他内容。" />
        <Control Id="Back" Type="PushButton" X="180" Y="243" Width="56" Height="17" Text="上一步(&amp;B)">
          <Publish Event="NewDialog" Value="OptionsDlg" Condition="1" />
        </Control>
        <Control Id="Next" Type="PushButton" X="236" Y="243" Width="56" Height="17" Default="yes" Text="下一步(&amp;N)">
          <Publish Event="SetTargetPath" Value="[WIXUI_INSTALLDIR]" Order="1" Condition="1" />
          <Publish Event="DoAction" Value="WixUIValidatePath_X64" Order="2" Condition="NOT WIXUI_DONTVALIDATEPATH" />
          <Publish Event="SpawnDialog" Value="InvalidDirDlg" Order="3" Condition="NOT WIXUI_DONTVALIDATEPATH AND WIXUI_INSTALLDIR_VALID&lt;&gt;&quot;1&quot;" />
          <Publish Event="NewDialog" Value="VerifyReadyDlg" Order="4" Condition="WIXUI_DONTVALIDATEPATH OR WIXUI_INSTALLDIR_VALID=&quot;1&quot;" />
        </Control>
        <Control Id="Cancel" Type="PushButton" X="304" Y="243" Width="56" Height="17" Cancel="yes" Text="取消">
          <Publish Event="EndDialog" Value="Exit" Condition="1" />
        </Control>
      </Dialog>

      <!-- 第二份目录对话框：内容与第一份完全相同，浏览按钮落点切回第一份 -->
      <Dialog Id="ChooseFolderDlg2" Width="370" Height="270" Title="[ProductName] — 选择安装目录">
        <Control Id="BannerBitmap" Type="Bitmap" X="0" Y="0" Width="370" Height="44" TabSkip="yes" Text="!(loc.InstallDirDlgBannerBitmap)" />
        <Control Id="Title" Type="Text" X="15" Y="6" Width="340" Height="15" Transparent="yes" Text="{\DshUIFontBold}选择安装目录" />
        <Control Id="Description" Type="Text" X="15" Y="23" Width="340" Height="15" Transparent="yes" Text="{\DshUIFont}选择 dsh-launcher 的安装位置" />
        <Control Id="BannerLine" Type="Line" X="0" Y="44" Width="370" Height="0" />
        <Control Id="BottomLine" Type="Line" X="0" Y="234" Width="370" Height="0" />
        <Control Id="FolderLabel" Type="Text" X="20" Y="78" Width="330" Height="15" Text="{\DshUIFont}安装到：" />
        <Control Id="Folder" Type="PathEdit" X="20" Y="95" Width="262" Height="19" Property="WIXUI_INSTALLDIR" Indirect="yes" />
        <Control Id="Browse" Type="PushButton" X="286" Y="94" Width="64" Height="21" Text="浏览(&amp;R)...">
          <Publish Property="_BrowseProperty" Value="[WIXUI_INSTALLDIR]" Order="1" Condition="1" />
          <Publish Event="DoAction" Value="LaunchModernFolderPicker" Order="2" Condition="1" />
          <Publish Event="DoAction" Value="ReadPickedFolder" Order="3" Condition="1" />
          <Publish Event="NewDialog" Value="ChooseFolderDlg" Order="4" Condition="1" />
        </Control>
        <Control Id="Note" Type="Text" X="20" Y="130" Width="330" Height="45" Text="{\DshUIFont}默认安装到 %ProgramFiles%\dsh-launcher（需管理员确认）。可在此直接输入或粘贴其他路径，如已有的 E:\ 目录；或点「浏览」用系统新版文件夹选择器。卸载只删除本应用的 7 个文件，不会删除目录中的其他内容。" />
        <Control Id="Back" Type="PushButton" X="180" Y="243" Width="56" Height="17" Text="上一步(&amp;B)">
          <Publish Event="NewDialog" Value="OptionsDlg" Condition="1" />
        </Control>
        <Control Id="Next" Type="PushButton" X="236" Y="243" Width="56" Height="17" Default="yes" Text="下一步(&amp;N)">
          <Publish Event="SetTargetPath" Value="[WIXUI_INSTALLDIR]" Order="1" Condition="1" />
          <Publish Event="DoAction" Value="WixUIValidatePath_X64" Order="2" Condition="NOT WIXUI_DONTVALIDATEPATH" />
          <Publish Event="SpawnDialog" Value="InvalidDirDlg" Order="3" Condition="NOT WIXUI_DONTVALIDATEPATH AND WIXUI_INSTALLDIR_VALID&lt;&gt;&quot;1&quot;" />
          <Publish Event="NewDialog" Value="VerifyReadyDlg" Order="4" Condition="WIXUI_DONTVALIDATEPATH OR WIXUI_INSTALLDIR_VALID=&quot;1&quot;" />
        </Control>
        <Control Id="Cancel" Type="PushButton" X="304" Y="243" Width="56" Height="17" Cancel="yes" Text="取消">
          <Publish Event="EndDialog" Value="Exit" Condition="1" />
        </Control>
      </Dialog>
    </UI>
  </Fragment>
</Wix>

